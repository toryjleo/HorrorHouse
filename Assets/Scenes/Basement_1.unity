      propertyPath: m_Name
      value: "Note - Emily 2 \u2013 Second thought"
      objectReference: {fileID: 0}
    - target: {fileID: 4909601476543146463, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: m_StaticEditorFlags
