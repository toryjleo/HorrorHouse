PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1345762119}
    m_Modifications:
    - target: {fileID: 4909601476543146463, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: m_Name
      value: Jacob 1
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: hasMultPages
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: noteText.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[0]'
      value: 'I found out you need the pawn, queen, and knight pieces to get out
        of here. I plugged them in those boxes near that small green doorway. The
        queen piece is going to be in a dark corner. I left a flashlight in the overalls
        on the rack. You can use it to see back there.

        Stick with me.

        I
        am going to get you out of here.

'
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[1]'
      value: "Last night, the beacon lit itself. No power, no crew. Just an eye in
        the fog, sweeping the sea. I can\u2019t tell if it\u2019s trying to warn
        us... or lure something in. We\u2019re leaving at dawn \u2014 if dawn still
        comes."
      objectReference: {fileID: 0}
    - target: {fileID: 8665333972906161904, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: m_LocalPosition.x
      value: 11.75
      objectReference: {fileID: 0}
    - target: {fileID: 8665333972906161904, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: m_LocalPosition.y
