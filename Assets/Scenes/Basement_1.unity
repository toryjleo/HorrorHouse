      objectReference: {fileID: 11400000, guid: 267f23515b1775c83898fa75bbe05dd1, type: 2}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: noteText.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[0]'
      value: "I never liked those Sawyer Sisters. Everyone in town thinks their all
        great since they play on the lacrosse team and they are in the choir. But
        some people don\u2019t know what makes people special. I saw them in the
        church choir 2 Sundays ago. Funny. I\u2019ve never seen them at church before.\n\n~
        Emily\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[1]'
      value: 'Jacob Violette, 16


        John Knight, Susan Knight'
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[2]'
      value: '

        Emily, 12


        Those damn Sawyer Sisters!


        John
        Mercier!


        And why was this notebook left out in the OPEN?'
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[3]'
      value: '

        Eli Violette, 8


        John Mercier'
      objectReference: {fileID: 0}
