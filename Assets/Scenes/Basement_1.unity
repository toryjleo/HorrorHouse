    m_Modifications:
    - target: {fileID: 4909601476543146463, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: m_Name
      value: "Note - Jacob 2 \u2013 What Happened "
      objectReference: {fileID: 0}
    - target: {fileID: 4909601476543146463, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: m_StaticEditorFlags
      value: 2147483647
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: hasMultPages
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: discoverySound
      value: 
      objectReference: {fileID: 11400000, guid: 267f23515b1775c83898fa75bbe05dd1, type: 2}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: noteText.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[0]'
      value: 'John asked me over to stack wood for him. Had the wood thrown down
        here in the basement and everything. Thought he was a nice guy. He bought
        me dunkins and doughnuts before I even showed up. But after I stacked 1 cord
        of wood, I decided to take a break. The very next moment, John had someone
        grab me from behind. Out of the shadows came John with a mean look in his
        eye. Motherfucker shoved a dirty rag in my face and I woke up in here. Those
        sons of bitches have it coming to them. Weird thing is, there was already
        the belongings in this room when I woke up here.

'
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[1]'
      value: 'Jacob Violette, 16


        John Knight, Susan Knight'
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[2]'
      value: '

        Emily, 12


        Those damn Sawyer Sisters!


        John
        Mercier!


        And why was this notebook left out in the OPEN?'
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[3]'
      value: '

        Eli Violette, 8


        John Mercier'
      objectReference: {fileID: 0}
