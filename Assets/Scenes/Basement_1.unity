    m_Modifications:
    - target: {fileID: 4909601476543146463, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: m_Name
      value: "Emily 2 \u2013 Second thought"
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: hasMultPages
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: noteText.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[0]'
      value: "So those sisters are awful! They approached me after Sunday service
        and asked me to join me for a walk. Sally Sawyer thinks she is just so pretty
        with that big clumpy necklace she wears. Well, it\u2019s ugly. Anyway we
        walked for a bit down Water Street and arrived at the post office. They asked
        me to join them again on Wednesday for the Elk lodge\u2019s Fish Chowder
        dinner. They told me to mind my \u201Cp\u2019s and q\u2019s\u201D and skipped
        off giggling. Damn those girls."
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[1]'
      value: 'Jacob Violette, 16


        John Knight, Susan Knight'
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[2]'
      value: '

        Emily, 12


        Those damn Sawyer Sisters!


        John
        Mercier!


        And why was this notebook left out in the OPEN?'
      objectReference: {fileID: 0}
    - target: {fileID: 4989890030215801003, guid: 12b022ca108b63653b3636eaf8bcd491, type: 3}
      propertyPath: 'noteText.Array.data[3]'
      value: '

        Eli Violette, 8


        John Mercier'
      objectReference: {fileID: 0}
